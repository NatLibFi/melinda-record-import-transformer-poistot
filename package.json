{
  "name": "@natlibfi/melinda-record-import-transformer-poistot",
  "description": "Record mass removal handler for the Melinda record batch import system",
  "author": {
    "name": "The National Library of Finland"
  },
  "keywords": [],
  "homepage": "https://github.com/natlibfi/melinda-record-import-transformer-poistot",
  "bugs": {
    "url": "https://github.com/natlibfi/melinda-record-import-transformer-poistot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:natlibfi/melinda-record-import-transformer-poistot.git"
  },
  "license": "MIT",
  "version": "3.0.0-alpha.1",
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/index.js",
    "cli": "npm run build && node dist/cli.js",
    "build": "esbuild \"src/**/*.js\" --sourcemap --platform=node --outdir=dist",
    "lint": "eslint ./src",
    "lint:dev": "eslint --fix ./src",
    "test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './src/**/*.test.js'",
    "test:base:only": "node --test --test-only --test-force-exit --experimental-test-coverage --test-reporter=spec './src/**/*.test.js'",
    "test": "npm run lint && npm run test:base",
    "watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/**/*.test.js'",
    "dev": "npm run watch:test",
    "dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
  },
  "dependencies": {
    "@natlibfi/marc-record": "^10.0.1",
    "@natlibfi/marc-record-serializers": "^11.0.4",
    "@natlibfi/marc-record-validate": "^9.0.2",
    "@natlibfi/marc-record-validators-melinda": "^13.0.4",
    "@natlibfi/melinda-backend-commons": "^3.0.4",
    "@natlibfi/melinda-commons": "^15.0.2",
    "@natlibfi/melinda-record-import-commons": "^13.0.6",
    "@natlibfi/sru-client": "^7.0.4",
    "amqplib": "^0.10.9",
    "moment": "^2.30.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@natlibfi/fixugen": "^3.0.1",
    "@natlibfi/fixura": "^4.0.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1"
  },
  "overrides": {
    "nanoid": "^3.3.8"
  }
}
